{
  "name": "yapasgachis-backend",
  "version": "1.0.0",
  "description": "Backend API for YapaGachis - Pan-African anti-food waste marketplace",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && cp -r src/images dist/images",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node src/infrastructure/database/prisma/seed.ts",
    "prisma:seed:massive": "ts-node src/infrastructure/database/prisma/seed-massive-test-data.ts",
    "prisma:seed:complete": "ts-node src/infrastructure/database/prisma/seed-complete-data.ts",
    "prisma:seed:frontend": "ts-node src/infrastructure/database/prisma/seed-frontend-data.ts",
    "prisma:seed:purchase-deals": "ts-node src/infrastructure/database/prisma/seed-purchase-deals.ts",
    "prisma:reset": "prisma migrate reset",
    "queue:worker": "ts-node src/infrastructure/queue/worker.ts",
    "cron": "ts-node src/cron/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:load": "artillery run tests/load/artillery.config.yml",
    "test:load:report": "artillery run tests/load/artillery.config.yml --output tests/load/report.json && artillery report tests/load/report.json",
    "lint": "npx eslint src/**/*.ts",
    "lint:fix": "npx eslint src/**/*.ts --fix",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "quality:full": "npm run lint && npm run format:check && npm run type-check && npm run test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "check-setup": "node scripts/check-setup.js",
    "security:audit": "npm audit --audit-level=moderate",
    "prepare": "husky install"
  },
  "keywords": [
    "anti-gaspillage",
    "marketplace",
    "food-waste",
    "africa",
    "express",
    "typescript",
    "prisma",
    "redis"
  ],
  "author": "YapaGachis Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.964.0",
    "@aws-sdk/client-textract": "^3.964.0",
    "@prisma/client": "^5.7.1",
    "@sentry/node": "^7.91.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.1.0",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "qrcode": "^1.5.3",
    "socket.io": "^4.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "artillery": "^2.0.27",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "npx eslint --fix",
      "npx prettier --write"
    ]
  },
  "prisma": {
    "schema": "src/infrastructure/database/prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} src/infrastructure/database/prisma/seed.ts"
  }
}
