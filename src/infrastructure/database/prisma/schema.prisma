// Historique des modifications des paramètres
model PlatformSettingsAudit {
  id String @id @default(uuid())

  settingKey String // Nom du paramètre modifié
  oldValue   String? // Ancienne valeur (JSON string)
  newValue   String // Nouvelle valeur (JSON string)

  changedById String
  changedBy   User   @relation("SettingsAudit", fields: [changedById], references: [id])

  reason String? // Raison du changement (optionnel)

  createdAt DateTime @default(now())

  @@index([settingKey])
  @@index([changedById])
  @@index([createdAt])
  @@map("platform_settings_audit")
}

