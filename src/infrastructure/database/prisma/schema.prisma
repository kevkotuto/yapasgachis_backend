// ==================== PAYMENT & ESCROW ====================

model EscrowTransaction {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Montants
  amount          Float // Montant total payé par le client
  commission      Float // Commission de la plateforme
  waveTransferFee Float @default(0) // Frais de transfert Wave (1%) - déduit du fournisseur
  supplierAmount  Float // Montant net à verser au fournisseur (après commission et frais Wave)

  // Status
  status EscrowStatus @default(PENDING)

  // Wave Payment Info
  waveCheckoutId String? // ID du checkout Wave
  wavePaymentId  String? // ID du paiement Wave confirmé
  waveTransferId String? // ID du transfert Wave vers le fournisseur

  // Supplier Info
  supplierId     String
  supplierWaveId String? // Compte Wave du fournisseur

  // Timestamps
  paidAt     DateTime? // Date de réception du paiement
  releasedAt DateTime? // Date de transfert au fournisseur
  refundedAt DateTime? // Date de remboursement si applicable

  // Dispute handling
  disputeReason     String?
  disputeOpenedAt   DateTime?
  disputeResolvedAt DateTime?
  disputeResolution String? // Description de la résolution

  // Admin actions
  adminActions AdminPaymentAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
  @@map("escrow_transactions")
}

model AdminPaymentAction {
  id                  String            @id @default(uuid())
  escrowTransactionId String
  escrowTransaction   EscrowTransaction @relation(fields: [escrowTransactionId], references: [id], onDelete: Cascade)

  adminId     String // ID de l'admin qui a effectué l'action
  actionType  String // REFUND, RELEASE, DISPUTE_OPEN, DISPUTE_CLOSE, MANUAL_TRANSFER
  description String? // Description de l'action
  amount      Float? // Montant si applicable (remboursement partiel, etc.)

  // Metadata
  previousStatus String? // Status avant l'action
  newStatus      String? // Status après l'action
  metadata       Json? // Données additionnelles

  createdAt DateTime @default(now())

  @@index([escrowTransactionId])
  @@index([adminId])
  @@index([createdAt])
  @@map("admin_payment_actions")
}

// ==================== WITHDRAWALS ====================

model Withdrawal {
  id           String           @id @default(uuid())
  supplierId   String
  supplier     SupplierProfile  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Montants
  amount       Float            // Montant brut demandé
  fee          Float            // Frais Wave (1% payout fee)
  netAmount    Float            // Montant net reçu (amount - fee)

  // Méthode
  method       PaymentMethod    @default(WAVE)
  phoneNumber  String           // Numéro de destination

  // Status
  status       WithdrawalStatus @default(PENDING)

  // Wave Payout Info
  wavePayoutId String?          // ID du payout Wave
  idempotencyKey String @unique // Pour éviter les doublons

  // Résultat
  processedAt  DateTime?
  failedReason String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

// ==================== PHASE 5: SUBSCRIPTIONS & DEALS MODELS ====================

// Plans d'abonnement définis par l'admin
model SubscriptionPlan {
  id String @id @default(uuid())

  // Plan Info
  name        String // "Basic", "Pro", "Premium"
  tier        SubscriptionTier @unique
  description String?

  // Pricing
  monthlyPrice Float // Prix mensuel en XOF
  yearlyPrice  Float? // Prix annuel (avec réduction)
  currency     String @default("XOF")

  // Limites et fonctionnalités
  maxStores       Int     @default(1) // Nombre max de magasins
  maxProducts     Int     @default(10) // Nombre max de produits
  maxDeals        Int     @default(0) // Nombre max de deals (0 = illimité)
  canCreateDeals  Boolean @default(false) // Peut créer des deals
  priorityListing Boolean @default(false) // Mise en avant dans les résultats
  analyticsAccess Boolean @default(false) // Accès aux analytics avancées

  // Commission
  commissionRate Float @default(0.10) // Taux de commission sur les ventes

  // Promo options
  trialDays Int @default(0) // Jours d'essai gratuit

  // Status
  isActive Boolean @default(true)
  isPublic Boolean @default(true) // Visible publiquement ou sur invitation

  // Relations
  suppliers  SupplierProfile[]
  promoCodes PromoCode[] // Codes promo applicables à ce plan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier, isActive])
  @@map("subscription_plans")
}

// Codes promo créés par l'admin pour fournisseurs particuliers
model PromoCode {
  id String @id @default(uuid())

  // Code Info
  code        String  @unique // "KAYZER2024", "USHIGO50"
  description String?

  // Type de réduction
  type  PromoCodeType // PERCENTAGE, FIXED_AMOUNT, FREE_MONTHS
  value Float // Valeur (%, montant, ou nombre de mois)

  // Applicabilité
  applicablePlanId String? // Si null, applicable à tous les plans
  applicablePlan   SubscriptionPlan? @relation(fields: [applicablePlanId], references: [id])

  // Fournisseur spécifique (si réservé à un fournisseur)
  reservedForSupplierId String?
  reservedForSupplier   SupplierProfile? @relation(fields: [reservedForSupplierId], references: [id])

  // Limites d'utilisation
  maxUses        Int? // Nombre max d'utilisations (null = illimité)
  currentUses    Int  @default(0)
  maxUsesPerUser Int  @default(1) // Utilisations max par fournisseur

  // Validité
  validFrom  DateTime  @default(now())
  validUntil DateTime? // null = pas d'expiration

  // Status
  status PromoCodeStatus @default(ACTIVE)

  // Créé par admin
  createdByAdminId String

  // Relations - fournisseurs ayant utilisé ce code
  usedBySuppliers SupplierProfile[] @relation("SupplierUsedPromoCode")
  usages          PromoCodeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([status, validFrom, validUntil])
  @@index([reservedForSupplierId])
  @@map("promo_codes")
}

// Historique d'utilisation des codes promo
model PromoCodeUsage {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  supplierId String // Fournisseur qui a utilisé le code

  // Détails de l'utilisation
  discountAmount Float // Montant économisé
  appliedTo      String // "SUBSCRIPTION", "FIRST_MONTH", etc.

  // Paiement associé
  subscriptionPaymentId String?

  usedAt DateTime @default(now())

  @@index([promoCodeId])
  @@index([supplierId])
  @@map("promo_code_usages")
}

// Deals / Bons Plans (ex: entrée piscine gratuite, chambre d'hôtel -50%)
model Deal {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Optionnel: lié à un magasin spécifique
  storeId String?
  store   SupplierStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Deal Info
  title       String // "Entrée piscine gratuite", "Chambre double -50%"
  description String
  category    DealCategory
  images      Json         @default("[]") // Array of image URLs

  // Pricing
  originalPrice   Float // Prix original
  dealPrice       Float // Prix avec réduction
  discountPercent Float? // Pourcentage de réduction calculé
  currency        String @default("XOF")

  // Ce qui est inclus
  includes Json? // ["Serviette", "Casier", "Accès vestiaires"]
  excludes Json? // ["Repas", "Boissons"]
  terms    String? // Conditions d'utilisation

  // Disponibilité
  status         DealStatus @default(DRAFT)
  availableFrom  DateTime // Date de début de validité
  availableUntil DateTime // Date de fin de validité

  // Créneaux disponibles
  availableSlots Json? // Créneaux horaires disponibles
  // Ex: [{"day": "monday", "slots": ["09:00-12:00", "14:00-18:00"]}]

  // Limites
  totalQuantity     Int // Nombre total disponible
  quantityAvailable Int // Nombre restant
  maxPerUser        Int @default(1) // Max par utilisateur

  // Période creuse (optionnel)
  isOffPeakOnly Boolean @default(false)
  offPeakDays   Json? // ["monday", "tuesday", "wednesday"]
  offPeakHours  Json? // {"start": "09:00", "end": "17:00"}

  // Réservation requise
  requiresBooking   Boolean     @default(true)
  bookingLeadTime   Int         @default(0) // Heures à l'avance pour réserver
  cancellationHours Int         @default(24) // Heures avant pour annuler gratuitement
  bookingMode       BookingMode @default(SINGLE_DATE) // Mode de réservation

  // Contact pour le deal
  contactPhone String?
  contactEmail String?

  // Stats
  views         Int @default(0)
  bookingsCount Int @default(0)
  usedCount     Int @default(0)

  // Modération
  moderatedAt        DateTime?
  moderatedByAdminId String?
  rejectionReason    String?

  // Relations
  bookings  DealBooking[]
  reviews   Review[]
  rooms     DealRoom[]
  favorites Favorite[]
  dealViews DealView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
  @@index([storeId, status])
  @@index([category, status])
  @@index([availableFrom, availableUntil])
  @@index([status])
  @@map("deals")
}

// Chambres/Rooms pour les deals hôteliers
model DealRoom {
  id     String @id @default(uuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Room Info
  title       String // "Studio pour 2 personnes"
  description String?
  price       Float // Prix de la chambre

  // Caractéristiques
  capacity String? // "2 pers max"
  size     String? // "28 m2"
  floor    String? // "Etage supérieur"

  // Équipements
  amenities Json? // ["WiFi gratuit", "Climatisation", etc.]
  bedTypes  Json? // ["Lit(s) double(s)"]
  images    Json? @default("[]") // Array of image URLs

  // Limites
  maxOccupancy Int?
  isAvailable  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([isAvailable])
  @@map("deal_rooms")
}

// Réservations de deals
model DealBooking {
  id     String @id @default(uuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId String

  // Booking Info
  bookingNumber String @unique @default(uuid())
  quantity      Int    @default(1)

  // Date et créneau réservés
  bookingDate    DateTime // Date de la réservation (check-in pour DATE_RANGE)
  bookingSlot    String? // Créneau horaire "14:00-18:00"
  bookingEndDate DateTime? // Date de fin (check-out) - NULL pour SINGLE_DATE
  numberOfNights Int? // Nombre de nuits - NULL pour SINGLE_DATE

  // Prix
  unitPrice  Float
  totalPrice Float

  // Status
  status BookingStatus @default(PENDING)

  // Code de validation
  validationCode String @unique // Code QR / PIN pour valider

  // Payment
  paymentMethod    PaymentMethod
  paymentReference String?
  paidAt           DateTime?

  // Utilisation
  usedAt        DateTime?
  usedByStaffId String? // Staff qui a validé

  // Annulation
  cancelledAt  DateTime?
  cancelReason String?
  refundedAt   DateTime?
  refundAmount Float?

  // Notes
  userNotes     String? // Notes du client
  supplierNotes String? // Notes du fournisseur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([userId])
  @@index([status])
  @@index([bookingDate])
  @@index([validationCode])
  @@index([dealId, bookingDate, bookingEndDate])
  @@map("deal_bookings")
}

