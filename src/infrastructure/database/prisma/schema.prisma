// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  CLIENT
  SUPPLIER_FOOD
  SUPPLIER_DEALS
  ASSOCIATION
  ADVERTISER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SupplierType {
  RESTAURANT
  BAKERY
  PASTRY_SHOP
  SUPERMARKET
  HOTEL
  LEISURE
  BEAUTY
  TRANSPORT
  OTHER
}

enum SubscriptionTier {
  BASIC
  PRO
  PREMIUM
}

enum ProductCategory {
  BAKERY_PASTRY // 1) Boulangeries - Pâtisseries
  GROCERY_BASKET // 2) Paniers supermarchés / fruits-légumes / épicerie / produits laitiers
  INTERNATIONAL_CUISINE // 3) Cuisine Internationale
  LOCAL_TRADITIONAL // 4) Plats locaux et traditionnels
  RESTAURANT // 5) Restaurants
  PREPARED_MEALS_INDIVIDUAL // 6) Plats préparés (Particuliers)
  MEAT_FISH // 7) Viandes & poissons
  OTHER // 8) Autres
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  EXPIRED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  IN_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum DeliveryPricingMode {
  FLAT // Prix fixe unique
  DISTANCE_BASED // Prix de base + prix par km
}

enum DonationType {
  FOOD
  FINANCIAL
}

enum DonationStatus {
  PENDING
  SCHEDULED
  COLLECTED
  DISTRIBUTED
  COMPLETED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdFormat {
  BANNER
  CARD
  INTERSTITIAL
}

enum NotificationType {
  // Order lifecycle
  ORDER_CONFIRMED
  ORDER_PAID
  ORDER_PREPARING
  ORDER_READY
  ORDER_IN_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_REFUNDED

  // Payment & Escrow
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ESCROW_RELEASED
  ESCROW_DISPUTED
  PAYOUT_FAILED

  // Products
  NEW_PRODUCT_NEARBY
  PRODUCT_EXPIRING_SOON

  // Donations
  DONATION_CONFIRMED

  // Subscriptions & Deals
  SUBSCRIPTION_EXPIRING
  DEAL_BOOKING_CONFIRMED
  DEAL_BOOKING_REMINDER

  // Campaigns & System
  CAMPAIGN_APPROVED
  SYSTEM_ANNOUNCEMENT
  PROMOTION_ALERT
  WELCOME
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  MTN_MOBILE_MONEY
  MOOV_MONEY
  CASH_ON_DELIVERY
}

enum PaymentProviderStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EscrowStatus {
  PENDING // En attente de paiement
  FUNDS_HELD // Fonds bloqués sur le compte de l'app
  RELEASED // Fonds transférés au fournisseur
  REFUNDED // Remboursé au client
  DISPUTED // En litige
  CANCELLED // Annulé
}

// ==================== PHASE 5: SUBSCRIPTIONS & DEALS ====================

enum DealStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
  ARCHIVED
}

enum DealCategory {
  // Nouvelles catégories Bons Plans
  CLOTHING_ACCESSORIES // Vêtements & accessoires
  HOME_FAMILY // MAISON & FAMILLE
  FLOWERS // Fleurs
  HOTELS_RESIDENCES // Hotels et residences
  COSMETICS // Cosmetiques
  FURNITURE // Meubles
  DIY_HARDWARE // Bricolages

  // Catégories existantes
  HOTEL_ROOM
  SPA_WELLNESS
  POOL_ACCESS
  GYM_FITNESS
  RESTAURANT_SPECIAL
  LEISURE_ACTIVITY
  BEAUTY_SERVICE
  TRANSPORT
  EVENT_TICKET
  OTHER
}

// ==================== PHASE 13: STORE STAFF MANAGEMENT ====================

enum StoreStaffRole {
  OWNER // Propriétaire - tous les droits
  MANAGER // Gérant - peut tout faire sauf supprimer le magasin/gérer le propriétaire
  CASHIER // Caissier - peut gérer les commandes
  STOCK_CLERK // Magasinier - peut gérer les produits/stock
}

enum StoreStaffInviteStatus {
  PENDING // Invitation envoyée
  ACCEPTED // Invitation acceptée
  REJECTED // Invitation refusée
  EXPIRED // Invitation expirée
  REVOKED // Invitation révoquée par le propriétaire
}

enum BookingStatus {
  PENDING
  CONFIRMED
  USED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum BookingMode {
  SINGLE_DATE // Une seule date (spa, restaurant)
  DATE_RANGE // Intervalle de dates (hôtel)
}

enum PromoCodeType {
  PERCENTAGE // Réduction en pourcentage
  FIXED_AMOUNT // Réduction montant fixe
  FREE_MONTHS // Mois gratuits sur abonnement
}

enum PromoCodeStatus {
  ACTIVE
  EXPIRED
  DISABLED
  FULLY_USED
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
  EXPIRED
}

enum PointTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum RewardTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum FrontendLogLevel {
  ERROR
  WARN
  INFO
  DEBUG
}

// ==================== MODELS ====================

model User {
  id           String     @id @default(uuid())
  phoneNumber  String?    @unique
  email        String?    @unique
  firstName    String
  lastName     String?
  role         UserRole
  status       UserStatus @default(PENDING_VERIFICATION)
  passwordHash String?
  avatar       String?
  language     String     @default("fr")

  // OAuth providers
  googleId           String? @unique
  appleId            String? @unique
  appleRefreshToken  String? // Apple OAuth refresh token, used for server-to-server token revocation on account deletion
  authProvider       String  @default("local") // "local", "google", "apple"

  // Location
  city         String?
  commune      String?
  neighborhood String?
  latitude     Float?
  longitude    Float?

  // Verification
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  kycVerified   Boolean @default(false)

  // Gamification
  contributorBadge Boolean @default(false)
  saverBadge       Boolean @default(false)
  donorBadge       Boolean @default(false)

  // Relations
  supplierProfile    SupplierProfile?
  associationProfile AssociationProfile?
  advertiserProfile  AdvertiserProfile?

  orders         Order[]
  reviews        Review[]
  reviewsHelpful ReviewHelpful[]
  donations      Donation[]
  favorites      Favorite[]
  productViews   ProductView[]
  dealViews      DealView[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]

  // Notification system
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?

  // Admin: Settings audit logs
  settingsAuditLogs PlatformSettingsAudit[] @relation("SettingsAudit")

  // Store Staff: employé dans des magasins
  storeStaffMemberships StoreStaff[] @relation("StoreStaffUser")
  storeStaffInvitations StoreStaff[] @relation("StoreStaffInviter")

  // Saved Locations
  savedLocations SavedLocation[]

  // Search History
  searchHistory SearchHistory[]

  // Favorite Stores
  favoriteStores FavoriteStore[]

  // Payment Methods
  paymentMethods UserPaymentMethod[]

  // Referral System
  referralCodes       ReferralCode[] // Codes de parrainage créés
  referralsAsReferrer Referral[]     @relation("Referrer") // Parrainages effectués
  referralsAsReferred Referral[]     @relation("Referred") // Parrainé par

  // Reward System
  rewards           UserRewards?
  pointTransactions PointTransaction[]

  // Frontend Logs
  frontendLogs FrontendLog[]

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phoneNumber, email])
  @@index([latitude, longitude])
  @@index([role, status])
  @@index([googleId])
  @@index([appleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model SupplierProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business Info
  businessName String
  supplierType SupplierType
  description  String?
  logo         String?
  coverImage   String?

  // Legal
  rccm           String? // Registry number
  niu            String? // Tax ID
  legalDocuments Json? // Array of document URLs

  // Pièce d'identité (KYC)
  idCardFront        String? // URL de la pièce d'identité recto
  idCardBack         String? // URL de la pièce d'identité verso
  selfiePhoto        String? // URL du selfie pour vérification faciale
  idCardType         String? // CNI, PASSPORT, DRIVING_LICENSE
  idCardNumber       String? // Numéro de la pièce d'identité
  idCardExpiry       DateTime? // Date d'expiration
  kycStatus          String    @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  kycSubmittedAt     DateTime?
  kycVerifiedAt      DateTime?
  kycRejectionReason String?

  // Siège social / Adresse principale (si pas de magasins)
  address         String?
  latitude        Float?
  longitude       Float?
  operatingHours  Json? // {monday: {open: "08:00", close: "20:00"}, ...}
  deliveryEnabled Boolean @default(false)
  pickupEnabled   Boolean @default(true)
  deliveryRadius  Float? // km

  // Subscription
  subscriptionTier      SubscriptionTier  @default(BASIC)
  subscriptionPlanId    String? // Lien vers le plan d'abonnement
  subscriptionPlan      SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  subscriptionActive    Boolean           @default(false)

  // Code promo utilisé à l'inscription
  usedPromoCodeId String?
  usedPromoCode   PromoCode? @relation("SupplierUsedPromoCode", fields: [usedPromoCodeId], references: [id])

  // Payment Settings
  acceptCashPayment Boolean @default(false)
  commissionRate    Float   @default(0.10)

  // Payout Settings (retrait des fonds)
  payoutProviderId      String? // Moyen de retrait choisi
  payoutProvider        PaymentProvider? @relation("SupplierPayoutProvider", fields: [payoutProviderId], references: [id])
  payoutAccountInfo     Json? // Infos du compte (phoneNumber, accountId, etc.)
  payoutAccountVerified Boolean          @default(false) // Compte de retrait vérifié

  // Stats globaux (agrégés de tous les magasins)
  totalSales    Int    @default(0)
  totalRevenue  Float  @default(0)
  averageRating Float?
  totalReviews  Int    @default(0)
  wasteReduced  Float  @default(0) // kg

  // Vérification
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  rejectionReason String?

  // Relations
  stores                  SupplierStore[] // Multi-magasins (Kayzer, Ushigo, etc.)
  products                Product[] // Produits (liés au supplier ou à un store)
  orders                  Order[]
  subscriptionPayments    SubscriptionPayment[]
  deals                   Deal[] // Bons plans
  withdrawals                 Withdrawal[] // Retraits de fonds
  promoCodes              PromoCode[] // Codes promo créés par admin pour ce fournisseur
  kycVerificationAttempts KycVerificationAttempt[] // Tentatives de vérification KYC

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([supplierType])
  @@index([subscriptionTier, subscriptionActive])
  @@index([isVerified])
  @@index([kycStatus])
  @@map("supplier_profiles")
}

// Magasin/Point de vente d'un fournisseur (ex: Kayzer Cocody, Kayzer Marcory, etc.)
model SupplierStore {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Store Info
  name        String // "Kayzer Cocody", "Ushigo Plateau"
  description String?
  images      Json?   @default("[]") // Photos du magasin

  // Location
  address      String
  city         String
  commune      String?
  neighborhood String?
  latitude     Float
  longitude    Float

  // Contact
  phoneNumber String?
  email       String?

  // Operating Hours
  operatingHours Json // {monday: {open: "08:00", close: "20:00"}, ...}

  // Delivery/Pickup Settings (peut être différent du supplier principal)
  deliveryEnabled Boolean @default(false)
  pickupEnabled   Boolean @default(true)
  deliveryRadius  Float? // km

  // Delivery Pricing Configuration
  deliveryPricingMode DeliveryPricingMode @default(DISTANCE_BASED)
  deliveryBasePrice   Decimal?            @db.Decimal(10, 2) // Prix de base (null = utilise businessSettings.defaultDeliveryFee)
  deliveryPricePerKm  Decimal?            @db.Decimal(10, 2) // Prix par km (null = utilise businessSettings.deliveryFeePerKm)
  deliveryFlatPrice   Decimal?            @db.Decimal(10, 2) // Prix fixe (null = utilise businessSettings.defaultDeliveryFee)

  // Payment Settings spécifiques au magasin
  acceptCashPayment Boolean @default(false)

  // Payout Settings (retrait des fonds) - optionnel, sinon hérite du supplier
  payoutProviderId      String? // Moyen de retrait choisi pour ce magasin
  payoutProvider        PaymentProvider? @relation("StorePayoutProvider", fields: [payoutProviderId], references: [id])
  payoutAccountInfo     Json? // Infos du compte (phoneNumber, accountId, etc.)
  payoutAccountVerified Boolean          @default(false)

  // Status
  isActive            Boolean @default(true)
  isTemporarilyClosed Boolean @default(false)
  closureReason       String?

  // Stats du magasin
  totalSales    Int    @default(0)
  totalRevenue  Float  @default(0)
  averageRating Float?
  totalReviews  Int    @default(0)

  // Relations
  products    Product[] // Produits de ce magasin
  orders      Order[] // Commandes de ce magasin
  deals       Deal[] // Deals de ce magasin
  staff       StoreStaff[] // Personnel du magasin
  favoritedBy FavoriteStore[] // Utilisateurs ayant mis ce magasin en favoris

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([latitude, longitude])
  @@index([city, commune])
  @@index([isActive])
  @@map("supplier_stores")
}

// Personnel d'un magasin (employés, gérants, etc.)
model StoreStaff {
  id      String        @id @default(uuid())
  storeId String
  store   SupplierStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Nullable: une invitation peut être créée AVANT que la personne ait un compte.
  // Le `userId` sera renseigné à l'acceptation (token) ou automatiquement à
  // l'inscription si le numéro/email correspond à `invitePhoneNumber` /
  // `inviteEmail`.
  userId  String?
  user    User?         @relation("StoreStaffUser", fields: [userId], references: [id], onDelete: Cascade)

  // Rôle et statut
  role     StoreStaffRole
  isActive Boolean        @default(true)

  // Permissions granulaires (surcharge du rôle si nécessaire)
  canManageProducts Boolean @default(false) // Créer/modifier/supprimer des produits
  canManageOrders   Boolean @default(false) // Voir et gérer les commandes
  canViewStats      Boolean @default(false) // Voir les statistiques du magasin
  canManageStaff    Boolean @default(false) // Inviter/supprimer du personnel
  canManageDeals    Boolean @default(false) // Créer/modifier des deals
  canManageSettings Boolean @default(false) // Modifier les paramètres du magasin

  // Invitation
  invitedById     String?
  invitedBy       User?                  @relation("StoreStaffInviter", fields: [invitedById], references: [id])
  invitedAt       DateTime               @default(now())
  acceptedAt      DateTime?
  inviteStatus    StoreStaffInviteStatus @default(PENDING)
  inviteToken     String?                @unique // Token pour accepter l'invitation
  inviteExpiresAt DateTime? // Expiration de l'invitation
  // Métadonnées de l'invité avant qu'il n'existe sur la plateforme. Utilisées
  // pour relier automatiquement le compte lorsqu'il s'inscrit avec ces données.
  invitePhoneNumber String?
  inviteEmail       String?
  inviteFirstName   String?
  inviteLastName    String?

  // Métadonnées
  notes        String? // Notes sur l'employé
  lastActiveAt DateTime? // Dernière activité

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
  @@index([inviteStatus])
  @@index([role])
  @@index([invitePhoneNumber])
  @@index([inviteEmail])
  @@map("store_staff")
}

model Product {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Optionnel: lié à un magasin spécifique
  storeId String?
  store   SupplierStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Product Info
  title       String
  description String
  category    ProductCategory
  images      Json            @default("[]") // Array of image URLs

  // Pricing
  originalPrice   Float
  discountedPrice Float
  commission      Float @default(0)

  // Inventory
  quantity          Int
  quantityAvailable Int
  unit              String @default("piece") // piece, kg, portion
  minStock          Int?   @default(5)
  maxStock          Int?   @default(20)

  // Food Safety
  expiryDate       DateTime? // DLC/DLUO
  isSurpriseBasket Boolean   @default(false)

  // Availability
  status         ProductStatus @default(DRAFT)
  availableFrom  DateTime?
  availableUntil DateTime?

  // Pickup/Delivery
  pickupSlots       Json? // Available time slots
  deliveryAvailable Boolean @default(false)

  // Promotion
  isSponsored      Boolean   @default(false)
  sponsorStartDate DateTime?
  sponsorEndDate   DateTime?

  // Stats
  views      Int @default(0)
  clicks     Int @default(0)
  orderCount Int @default(0)

  // Relations
  orderItems     OrderItem[]
  favorites      Favorite[]
  productViews   ProductView[]
  reviews        Review[]
  donations      Donation[]
  stockMovements StockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([supplierId, status])
  @@index([storeId, status])
  @@index([category, status])
  @@index([expiryDate])
  @@map("products")
}

model Order {
  id          String          @id @default(uuid())
  orderNumber String          @unique @default(uuid())
  clientId    String
  client      User            @relation(fields: [clientId], references: [id])
  supplierId  String
  supplier    SupplierProfile @relation(fields: [supplierId], references: [id])

  // Optionnel: lié à un magasin spécifique
  storeId String?
  store   SupplierStore? @relation(fields: [storeId], references: [id])

  // Order Details
  status         OrderStatus    @default(PENDING_PAYMENT)
  deliveryMethod DeliveryMethod

  // Amounts
  subtotal        Float
  deliveryFee     Float @default(0)
  commission      Float // Commission prélevée par la plateforme
  wavePaymentFee  Float @default(0) // Frais de paiement Wave (1%) - payé par le client
  waveTransferFee Float @default(0) // Frais de transfert Wave (1%) - déduit du fournisseur
  supplierAmount  Float // Montant net à reverser au fournisseur (total - commission - waveTransferFee)
  total           Float // Total payé par le client (subtotal + deliveryFee + wavePaymentFee)

  // Pickup/Delivery
  pickupCode          String? // QR code / PIN
  pickupSlot          DateTime?
  scheduledPickupTime String? // Créneau de retrait "14:00-16:00"

  deliveryAddress   String?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryNotes     String?

  // Payment
  paymentMethod    PaymentMethod // WAVE ou CASH_ON_DELIVERY
  paymentReference String? // Référence Wave
  paidAt           DateTime?

  // Delivery Confirmation
  deliveredAt               DateTime?
  deliveryConfirmedByClient Boolean   @default(false)

  // Relations
  items             OrderItem[]
  tracking          DeliveryTracking[]
  escrowTransaction EscrowTransaction?

  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  @@index([clientId])
  @@index([supplierId, status])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int
  unitPrice  Float
  totalPrice Float

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, dealId])
  @@index([userId])
  @@index([productId])
  @@index([dealId])
  @@map("favorites")
}

// Historique des vues de produits pour recommandations
model ProductView {
  id        String  @id @default(uuid())
  userId    String? // Null pour visiteurs non-connectés
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tracking
  viewCount    Int      @default(1)
  lastViewedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([lastViewedAt])
  @@map("product_views")
}

// Historique des vues de deals pour recommandations
model DealView {
  id     String  @id @default(uuid())
  userId String? // Null pour visiteurs non-connectés
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId String
  deal   Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Tracking
  viewCount    Int      @default(1)
  lastViewedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dealId])
  @@index([userId])
  @@index([dealId])
  @@index([lastViewedAt])
  @@map("deal_views")
}

model AssociationProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String
  logo        String?

  // Legal
  registrationNumber String
  legalDocuments     Json?

  // Location
  address     String
  latitude    Float
  longitude   Float
  serviceArea Json // Array of zones served

  // Acceptance
  acceptedFoodTypes  Json // [dry, fresh, prepared]
  collectionSchedule Json // Weekly schedule
  collectionPoints   Json?

  // Banking
  mobileMoney String?
  bankAccount Json?

  // Stats
  totalDonationsReceived Int   @default(0)
  totalValueReceived     Float @default(0)

  // Relations
  donations Donation[]
  reports   AssociationReport[]

  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("association_profiles")
}

model Donation {
