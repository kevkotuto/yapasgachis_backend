  deviceId   String? // Unique device identifier

  // Token validity
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())

  // Metadata
  appVersion String?
  osVersion  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([token])
