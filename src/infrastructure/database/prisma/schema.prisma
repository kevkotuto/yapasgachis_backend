  updatedAt DateTime @updatedAt

  @@index([productId, rating])
  @@index([dealId, rating])
  @@index([userId])
  @@map("reviews")
}

// Table pour tracker les "utile" des reviews
model ReviewHelpful {
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_helpful")
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  message String
  data    Json? // Additional payload (orderId, productId, etc.)

  read   Boolean   @default(false)
  readAt DateTime?

  // Push notification tracking
  pushSent     Boolean   @default(false)
  pushSentAt   DateTime?
  pushReceipts Json? // Store Expo push receipts for debugging

  // Email tracking (for admin notifications)
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  // Priority and scheduling
  priority     NotificationPriority @default(NORMAL)
  scheduledFor DateTime? // For scheduled notifications
  expiresAt    DateTime? // Auto-expire notifications

  // Grouping
  groupKey String? // Group related notifications

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, type])
  @@index([createdAt])
  @@index([scheduledFor])
  @@map("notifications")
}

// Device tokens for push notifications (Expo Push)
model DeviceToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String     @unique // Expo Push Token (ExponentPushToken[xxx])
  deviceType DeviceType
