// ==================== PHASE 12: KYC AI VERIFICATION ====================

enum KycVerificationStatus {
  PENDING // En attente de traitement
  PROCESSING // En cours de vérification par l'IA
  AI_APPROVED // Approuvé automatiquement par l'IA
  AI_REJECTED // Rejeté automatiquement par l'IA
  MANUAL_REVIEW // Score trop bas, nécessite review manuel
  MANUALLY_APPROVED // Approuvé manuellement par admin
  MANUALLY_REJECTED // Rejeté manuellement par admin
  FAILED // Erreur technique lors de la vérification
}

enum IdCardType {
  CNI // Carte Nationale d'Identité
  PASSPORT // Passeport
  DRIVING_LICENSE // Permis de conduire
  RESIDENCE_CARD // Carte de séjour
}

enum KycCheckType {
  DOCUMENT_OCR // Extraction de texte du document
  DOCUMENT_VALIDITY // Vérification de validité (format, expiration)
  DOCUMENT_AUTHENTICITY // Détection de falsification
  FACE_MATCH // Correspondance visage ID vs selfie
  LIVENESS_DETECTION // Détection de vivacité (anti-spoofing)
}

// Tentative de vérification KYC
model KycVerificationAttempt {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Documents soumis
  idCardFrontUrl String // URL de la pièce d'identité recto
  idCardBackUrl  String? // URL de la pièce d'identité verso (optionnel selon le type)
  selfieUrl      String // URL du selfie
  idCardType     IdCardType // Type de document

  // Status de la vérification
  status KycVerificationStatus @default(PENDING)

  // Scores globaux (0-100)
  overallScore   Float? // Score global de confiance
  documentScore  Float? // Score qualité/authenticité document
  faceMatchScore Float? // Score correspondance visage
  livenessScore  Float? // Score de vivacité

  // Seuils utilisés pour cette vérification
  autoApproveThreshold  Float @default(85) // Score minimum pour approbation auto
  manualReviewThreshold Float @default(60) // Score en dessous = review manuel

  // Résultats détaillés (JSON)
  ocrResults       Json? // Données extraites par OCR
  documentAnalysis Json? // Analyse du document (authenticité, validité)
  faceAnalysis     Json? // Analyse de la correspondance faciale
  livenessAnalysis Json? // Analyse de la vivacité

  // Erreurs éventuelles
  errorCode    String? // Code d'erreur si échec
  errorMessage String? // Message d'erreur détaillé

  // Provider utilisé
  aiProvider String @default("aws-rekognition") // aws-rekognition, azure, google

  // Timing
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  processingDurationMs  Int? // Durée en millisecondes

  // Review manuel (si nécessaire)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  reviewNotes       String?

  // Relations
  checks KycVerificationCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("kyc_verification_attempts")
}

// Détail de chaque vérification individuelle (OCR, Face Match, etc.)
model KycVerificationCheck {
  id        String                 @id @default(uuid())
  attemptId String
  attempt   KycVerificationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Type de vérification
  checkType KycCheckType

  // Résultat
  passed     Boolean? // null = en cours, true = réussi, false = échoué
  score      Float? // Score de confiance (0-100)
  confidence Float? // Niveau de confiance de l'IA

  // Détails du résultat (JSON spécifique au type de check)
  result Json?

  // Raison d'échec si applicable
  failureReason String?

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())

  @@index([attemptId])
  @@index([checkType])
  @@map("kyc_verification_checks")
}

// Données extraites par OCR du document d'identité
model KycExtractedData {
  id        String @id @default(uuid())
  attemptId String @unique

  // Informations extraites
  documentNumber String? // Numéro du document
  firstName      String? // Prénom
  lastName       String? // Nom
  dateOfBirth    DateTime? // Date de naissance
  placeOfBirth   String? // Lieu de naissance
  gender         String? // Sexe (M/F)
  nationality    String? // Nationalité

  // Dates du document
  issueDate        DateTime? // Date d'émission
  expiryDate       DateTime? // Date d'expiration
  issuingAuthority String? // Autorité émettrice
  issuingCountry   String? // Pays d'émission

  // Adresse (si présente)
  address String?

  // Confiance de l'extraction
  extractionConfidence Float? // Confiance globale de l'extraction (0-100)
  fieldConfidences     Json? // Confiance par champ {"firstName": 95.5, "lastName": 92.3, ...}

  // Validation
  isExpired Boolean? // Document expiré ?
  isValid   Boolean? // Format valide ?

  createdAt DateTime @default(now())

  @@map("kyc_extracted_data")
}

// Historique des notifications KYC envoyées
model KycNotification {
  id         String @id @default(uuid())
  supplierId String

  // Type de notification
  notificationType String // KYC_SUBMITTED, KYC_APPROVED, KYC_REJECTED, KYC_MANUAL_REVIEW, KYC_RESUBMIT_REQUIRED

  // Contenu
  title   String
  message String

  // Méthodes de livraison
  pushSent  Boolean @default(false)
  emailSent Boolean @default(false)
  smsSent   Boolean @default(false)

  // Référence à la tentative
  attemptId String?

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@index([attemptId])
  @@map("kyc_notifications")
}

// ==================== SAVED LOCATIONS ====================

// Adresses favorites des utilisateurs
model SavedLocation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location Info
  label        String // "Maison", "Bureau", "Chez Maman", etc.
  address      String
  city         String?
  commune      String?
  neighborhood String?
  latitude     Float
  longitude    Float

  // Additional Info
  instructions String? // Instructions de livraison
  phoneNumber  String? // Numéro à contacter pour cette adresse

  // Flags
  isDefault Boolean @default(false) // Adresse par défaut

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@map("saved_locations")
}

// Historique des recherches pour suggestions et tendances
model SearchHistory {
  id     String  @id @default(uuid())
  userId String? // Null pour utilisateurs non connectés
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Search details
  query   String // Terme recherché
  type    String // 'product' ou 'deal'
  filters Json? // Filtres appliqués (category, price range, etc.)

  // Metadata
  resultCount Int? // Nombre de résultats trouvés
  clicked     Boolean @default(false) // L'utilisateur a-t-il cliqué sur un résultat?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([query]) // Pour trending searches
  @@index([type, createdAt])
  @@map("search_history")
}

// Magasins/Fournisseurs favoris des utilisateurs
model FavoriteStore {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierStoreId String
  supplierStore   SupplierStore @relation(fields: [supplierStoreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, supplierStoreId])
  @@index([userId])
  @@index([supplierStoreId])
  @@map("favorite_stores")
}

// ==================== STOCK MOVEMENTS ====================

enum StockMovementType {
  PURCHASE // Achat/Approvisionnement
  SALE // Vente
  ADJUSTMENT // Ajustement manuel
  LOSS // Perte (expiration, casse)
  RETURN // Retour client
  TRANSFER // Transfert entre magasins
}

// Historique des mouvements de stock
model StockMovement {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Type et quantité
  type          StockMovementType
  quantity      Int // Positif pour entrée, négatif pour sortie
  previousStock Int // Stock avant le mouvement
  newStock      Int // Stock après le mouvement

  // Reference
  orderId    String? // Si lié à une commande
  supplierId String // Fournisseur concerné
  storeId    String? // Magasin concerné (si applicable)

  // Details
  reason        String? // Raison du mouvement
  notes         String? // Notes additionnelles
  performedById String? // ID de l'utilisateur qui a effectué le mouvement

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([storeId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ==================== PAYMENT PROVIDERS ====================

// Fournisseurs de paiement configurables par l'admin
model PaymentProvider {
  id String @id @default(uuid())

  // Provider Info
  name        String // "Wave", "Orange Money", "MTN Mobile Money"
  slug        String  @unique // "wave", "orange-money", "mtn-mobile-money"
  description String? // Description du moyen de paiement

  // Logo
  logoUrl String? // URL du logo
  iconUrl String? // URL de l'icône (optionnel, version plus petite)

  // Configuration
  isActive Boolean               @default(true)
  status   PaymentProviderStatus @default(ACTIVE)

  // Frais
  paymentFeeRate  Float  @default(0) // Frais de paiement (%)
  transferFeeRate Float  @default(0) // Frais de transfert (%)
  minAmount       Float? // Montant minimum
  maxAmount       Float? // Montant maximum

  // Pays supportés
  supportedCountries  Json? // ["CI", "SN", "BF", ...]
  supportedCurrencies Json? // ["XOF", "XAF", ...]

  // Configuration technique (API keys, etc.) - chiffrée en production
  config Json? // Configuration spécifique au provider

  // Métadonnées
  displayOrder Int     @default(0) // Ordre d'affichage
  isFeatured   Boolean @default(false) // Mise en avant

  // Admin
  createdByAdminId String?
  updatedByAdminId String?

  // Relations - Fournisseurs utilisant ce moyen de paiement pour les retraits
  supplierPayouts SupplierProfile[] @relation("SupplierPayoutProvider")
  storePayouts    SupplierStore[]   @relation("StorePayoutProvider")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive, status])
  @@index([displayOrder])
  @@map("payment_providers")
}

// ==================== USER PAYMENT METHODS ====================

// Méthodes de paiement enregistrées par les utilisateurs
model UserPaymentMethod {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Provider info
  provider    String // "WAVE", "ORANGE_MONEY", "MTN_MONEY", "MOOV_MONEY"
  phoneNumber String // Numéro de compte mobile money
  accountName String // Nom sur le compte

  // Status
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([isDefault])
  @@map("user_payment_methods")
}

// ==================== REFERRAL SYSTEM ====================

// Codes de parrainage créés par les utilisateurs
model ReferralCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Code
  code String @unique // "JOHN2024", "YAPAS-ABC123"

  // Usage
  timesUsed Int     @default(0)
  maxUses   Int? // Null = illimité
  isActive  Boolean @default(true)

  // Expiration
  expiresAt DateTime?

  // Relations
  referrals Referral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([code])
  @@map("referral_codes")
}

// Historique des parrainages
model Referral {
  id String @id @default(uuid())

  // Parrain
  referrerId     String
  referrer       User         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  // Filleul
  referredUserId String
  referredUser   User   @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  // Status
  status ReferralStatus @default(PENDING)

  // Récompenses
  rewardEarned Float? // Montant/points gagnés

  // Dates
  completedAt DateTime? // Quand le filleul a fait son 1er achat
  rewardedAt  DateTime? // Quand la récompense a été donnée

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([referralCodeId, referredUserId])
  @@index([referrerId])
  @@index([referredUserId])
  @@map("referrals")
}

// ==================== REWARD SYSTEM ====================

model UserRewards {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Points
  totalPoints     Float @default(0) // Total des points actuels
  availablePoints Float @default(0) // Points disponibles pour utilisation
  lifetimePoints  Float @default(0) // Total des points gagnés à vie

  // Tier/Niveau
  currentTier RewardTier @default(BRONZE)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([currentTier])
  @@map("user_rewards")
}

model PointTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transaction details
  amount      Float // Montant (positif = gagné, négatif = dépensé)
  type        PointTransactionType // Type de transaction
  source      String // Source (REFERRAL, ORDER, REVIEW, etc.)
  description String // Description de la transaction

  // Metadata
  reference String? // Référence externe (ex: order ID, referral ID)
  balance   Float     @default(0) // Solde après transaction
  expiresAt DateTime? // Date d'expiration des points (si applicable)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([source])
  @@index([createdAt])
  @@map("point_transactions")
}

// ==================== FRONTEND LOGGING ====================

model FrontendLog {
  id String @id @default(uuid())

  // Basic log information
  level     FrontendLogLevel
  message   String           @db.Text
  timestamp DateTime         @default(now())

  // Context information
  page   String? @db.VarChar(255)
  action String? @db.VarChar(255)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Technical information
  userAgent String? @db.Text
  stack     String? @db.Text
  file      String? @db.VarChar(500)
  line      Int?

  // Session tracking
  sessionId String? @db.VarChar(255)
  deviceId  String? @db.VarChar(255)

  // Additional metadata (extensible)
  metadata Json? @default("{}")

  createdAt DateTime @default(now())

  // Indexes for efficient querying
  @@index([level])
  @@index([timestamp])
  @@index([userId])
  @@index([sessionId])
  @@index([level, timestamp])
  @@index([userId, timestamp])
  @@map("frontend_logs")
}
