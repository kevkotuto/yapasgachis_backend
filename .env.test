# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database (use a separate test database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/yapasgachis_test?schema=public

# Test Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# JWT (use different secrets for tests)
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Disable external services in tests
ENABLE_NOTIFICATIONS=false
ENABLE_ANALYTICS=false
ENABLE_CRON_JOBS=false

# Mock credentials (no real API calls in tests)
SENDGRID_API_KEY=mock-sendgrid-key
TWILIO_ACCOUNT_SID=mock-twilio-sid
CLOUDINARY_CLOUD_NAME=mock-cloud
STRIPE_SECRET_KEY=sk_test_mock

# Test-specific settings
BCRYPT_ROUNDS=4
OTP_EXPIRATION=300000
LOG_LEVEL=error
